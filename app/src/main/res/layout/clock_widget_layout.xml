<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Centered Visual Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <!-- Timezone Indicator -->
        <TextView
            android:id="@+id/widget_timezone_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="🇧🇩 Dhaka, Bangladesh"
            android:textColor="#E6E0FFFA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:shadowColor="#C0000000"
            android:shadowRadius="3"
            android:shadowDx="1"
            android:shadowDy="1"
            android:layout_marginBottom="2dp" />

        <!-- High-Contrast Elegant Clock with adjacent smaller AM/PM -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal">

            <TextClock
                android:id="@+id/widget_clock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:shadowColor="#E0000000"
                android:shadowRadius="4"
                android:shadowDx="1.5"
                android:shadowDy="1.5" />

            <TextClock
                android:id="@+id/widget_ampm_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="3dp"
                android:shadowColor="#E0000000"
                android:shadowRadius="3"
                android:shadowDx="1"
                android:shadowDy="1" />
        </LinearLayout>

        <!-- Subtitle Date (TextClock to keep fully live) -->
        <TextClock
            android:id="@+id/widget_subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, MMMM d"
            android:format24Hour="EEE, MMMM d"
            android:textColor="#F2FFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:textStyle="normal"
            android:shadowColor="#C0000000"
            android:shadowRadius="3"
            android:shadowDx="1"
            android:shadowDy="1"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</FrameLayout>
